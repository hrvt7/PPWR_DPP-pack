generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DPP {
  id                      String   @id @default(cuid())
  productId               String?
  destinationCountry      String?
  createdAt               DateTime @default(now())

  carbonMaterialCo2       Float?
  carbonTransportCo2      Float?
  carbonTotalCo2          Float?
  carbonCalculationDate   DateTime?
  carbonCalculationMethod String? @default("EU_AVERAGE_LIGHT_V1")
}
